SUPABASE_DB_PASSWORD=UPDATE_THIS_wITH_YOUR_SUPABASE_SUPABASE_DB_PASSWORD

# TPV Virtual de BBVA (Redsys). La clave de firma es secreta: solo en Vercel, jamás en git.
REDSYS_MERCHANT_CODE=370662108
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=PEGA_AQUI_LA_CLAVE_SHA256_DE_BBVA
# test = pruebas en sis-t.redsys.es · live = cobros reales
REDSYS_ENV=test
# 978 = EUR
REDSYS_CURRENCY=978
# true solo cuando BBVA confirme que el pago por referencia está activado
REDSYS_PAGO_REFERENCIA=false

# Update this with your resend.com credentials from https://resend.com/api-keys
